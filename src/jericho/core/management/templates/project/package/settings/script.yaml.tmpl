# Сценарий для бэкенда без модели: на какое поручение какие ручки вызвать и что ответить.
# Запись без `when` отвечает на всё остальное. Пример записи с вызовами:
#
# - when: открой
#   calls:
#     - tool: load_skill
#       arguments: {names: [имя_навыка]}
#     - tool: имя_ручки
#       arguments: {поле: значение}
#   reply: {status: done, message: Открыл}

- reply: {status: done, message: "Ассистент $name собран. Модели пока нет: отвечаю по сценарию."}
