[project]
name = "$name"
version = "0.1.0"
description = "Ассистент на каркасе Jericho"
requires-python = ">=3.14"
dependencies = [
    "$jericho_requirement",
]

[project.scripts]
$command = "$package.__main__:main"

[build-system]
requires = ["uv_build>=0.12.5,<0.13.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "$package"
$jericho_source
[dependency-groups]
dev = [
    "pytest>=9.1.1",
]

[tool.basedpyright]
typeCheckingMode = "standard"
venvPath = "."
venv = ".venv"

[tool.ruff]
target-version = "py314"
line-length = 150      # длину строки не проверяем (E501 не включён); число нужно только сортировке импортов

[tool.ruff.lint]
# Ошибки, порядок импортов, упрощения, изменяемые атрибуты класса без ClassVar. Автоформата нет.
select = ["F", "E9", "I", "B", "SIM", "C4", "PIE", "UP", "RUF012", "RUF022", "RUF100", "PLR0402"]
ignore = ["SIM108"]

[tool.ruff.lint.isort]
known-first-party = ["$package"]

[tool.pytest.ini_options]
testpaths = ["tests", "src/$package/skills", "src/$package/services"]
